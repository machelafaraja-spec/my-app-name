# ─── AfyaApp Production Environment Variables ───
# Copy this file to .env and fill in your production credentials.
# DO NOT commit the real .env file to version control.

# ─── Supabase (pre-configured) ───
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── WebRTC: Agora.io ───
# Get these from https://console.agora.io/ → Project Management
VITE_AGORA_APP_ID=your-agora-app-id
# AGORA_APP_CERTIFICATE is set on Supabase Edge Functions (server-side only)
# AGORA_APP_ID=your-agora-app-id        (set in Supabase Edge Function secrets)
# AGORA_APP_CERTIFICATE=your-cert      (set in Supabase Edge Function secrets)

# ─── WebRTC: Twilio (alternative to Agora) ───
# Get these from https://www.twilio.com/console → Video
# TWILIO_ACCOUNT_SID=your-sid          (set in Supabase Edge Function secrets)
# TWILIO_API_KEY=your-api-key           (set in Supabase Edge Function secrets)
# TWILIO_API_SECRET=your-api-secret     (set in Supabase Edge Function secrets)

# ─── Firebase Cloud Messaging (Push Notifications) ───
# Get these from https://console.firebase.google.com/ → Project Settings → Cloud Messaging
# FCM_SERVER_KEY=your-fcm-server-key   (set in Supabase Edge Function secrets)
# VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","messagingSenderId":"...","appId":"..."}

# ─── Payment Gateway (Stripe) ───
# Get these from https://dashboard.stripe.com/apikeys
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key
# STRIPE_SECRET_KEY=sk_live_your_secret_key     (set in Supabase Edge Function secrets)
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret (set in Supabase Edge Function secrets)

# ─── Supabase Service Role (server-side only — NEVER expose to client) ───
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  (set in Supabase Edge Function secrets)
