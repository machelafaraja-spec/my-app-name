# ─── AfyaApp Production Environment Variables ───
# Copy this file to .env and fill in your production credentials.
# DO NOT commit the real .env file to version control.

# ─── Supabase (pre-configured) ───
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── WebRTC: Agora.io ───
VITE_AGORA_APP_ID=your-agora-app-id

# ─── WebRTC: Twilio (alternative to Agora) ───
# TWILIO_ACCOUNT_SID=your-sid
# TWILIO_API_KEY=your-api-key
# TWILIO_API_SECRET=your-api-secret

# ─── Firebase Cloud Messaging (Push Notifications) ───
# FCM_SERVER_KEY=your-fcm-server-key
# VITE_FIREBASE_CONFIG={...}

# ─── Payment Gateway (Stripe) ───
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key
# STRIPE_SECRET_KEY=sk_live_your_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ─── Supabase Service Role (server-side only) ───
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
